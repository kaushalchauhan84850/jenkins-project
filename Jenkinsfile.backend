pipeline {
    agent {
        label 'electronix'
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '416394563192.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'electronic-backend'
        IMAGE_TAG    = 'latest'
    }

    stages {

        stage('Verify Environment') {
            steps {
                sh '''
                    whoami
                    groups
                    docker --version
                    aws --version
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    sudo docker login --username AWS --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Build Image') {
            steps {
                dir('backend'){
                    sh '''
                     sudo docker build -t ${ECR_REPO}:${IMAGE_TAG} .
                }   '''
            }
        }

        stage('Tag Image') {
            steps {
                sh '''
                    sudo docker tag ${ECR_REPO}:${IMAGE_TAG} \
                    ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    sudo docker push \
                    ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    sudo docker image prune -f
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Docker image pushed successfully!'
        }

        failure {
            echo '❌ Pipeline failed.'
        }
    }
}